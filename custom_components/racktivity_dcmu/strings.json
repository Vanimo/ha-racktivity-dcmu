          "scan_interval": "Scan interval",
          "config_interval": "Configuration interval",
          "enable_control": "Allow switching outlet relays",
          "write_community": "Write community",
          "web_username": "Web username",
          "web_password": "Web password",
          "http_interval": "Web API interval"
        }
      }
    },

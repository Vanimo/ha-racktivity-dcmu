  "options": {
    "step": {
      "init": {
        "title": "Racktivity DCMU options",
        "description": "Live values and relay states are read every scan interval; names, thresholds and peaks every configuration interval (and right after a relay change).\n\nRelay switching is off by default. It needs both the checkbox and the SNMP write community; without them outlets are read-only binary sensors.\n\nOptional: with the web login, values SNMP does not provide (lifetime energy, firmware version, external sensors, the device event log) are read from the web interface every web API interval. Only reads are done.\n\nWith relay control, each outlet also gets a **Power cycle** button: off, wait the configured time, on.",
        "data": {
          "scan_interval": "Scan interval",
          "config_interval": "Configuration interval",
          "enable_control": "Allow switching outlet relays",
          "write_community": "Write community",
          "web_username": "Web username",
          "web_password": "Web password",
          "http_interval": "Web API interval",
          "cycle_delay": "Power cycle off time"
        }
      }
    },
